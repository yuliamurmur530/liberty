<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/asphalt_700" />
            <stroke android:width="1dp" android:color="@color/steel_300" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/asphalt_800" />
            <stroke android:width="1dp" android:color="@color/asphalt_700" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>

