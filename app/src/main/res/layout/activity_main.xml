<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_logo_avatar_small"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:outlineProvider="background"
                android:src="@drawable/ic_liberty_mark" />

            <TextView
                style="@style/Text.Liberty.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/app_name"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            style="@style/Text.Liberty.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/app_tagline" />

        <TextView
            android:id="@+id/heroTitle"
            style="@style/Text.Liberty.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_title" />

        <TextView
            android:id="@+id/heroBody"
            style="@style/Text.Liberty.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_intro" />

        <LinearLayout
            android:id="@+id/statusCard"
            style="@style/Widget.Liberty.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/statusTitle"
                style="@style/Text.Liberty.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/statusBody"
                style="@style/Text.Liberty.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/setupSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Widget.Liberty.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Liberty.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step_two_title" />

                <TextView
                    style="@style/Text.Liberty.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/step_two_body" />

                <TextView
                    style="@style/Text.Liberty.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/signin_bridge_title"
                    android:textSize="16sp" />

                <TextView
                    style="@style/Text.Liberty.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/signin_bridge_body"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/chooseAccountButton"
                    style="@style/Widget.Liberty.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/choose_signin_account" />

                <Button
                    android:id="@+id/createSpaceButton"
                    style="@style/Widget.Liberty.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/create_space" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/openProtectedSpaceButton"
            style="@style/Widget.Liberty.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/open_protected_space"
            android:visibility="gone" />

        <Button
            android:id="@+id/removeLibertyButton"
            style="@style/Widget.Liberty.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/remove_liberty_and_space"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dataNote"
            style="@style/Text.Liberty.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/data_note"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/changeLanguageButton"
                style="@style/Widget.Liberty.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/language_settings" />

            <Button
                android:id="@+id/openPrivacyButton"
                style="@style/Widget.Liberty.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/privacy_settings" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
