<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/securityCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_logo_avatar_small"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:outlineProvider="background"
            android:src="@drawable/ic_liberty_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Liberty.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vault_title"
                android:textSize="22sp" />

            <TextView
                style="@style/Text.Liberty.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card_success"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/securityStatusIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_shield_check" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/securityStatusTitle"
                style="@style/Text.Liberty.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/security_active"
                android:textColor="@color/success" />

            <TextView
                android:id="@+id/securitySummary"
                style="@style/Text.Liberty.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/security_summary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/networkStatusTitle"
                style="@style/Text.Liberty.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/network_checking_title"
                android:textColor="@color/liberty_gold" />

            <TextView
                android:id="@+id/networkStatusBody"
                style="@style/Text.Liberty.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/network_checking_body"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/challengeCard"
        style="@style/Widget.Liberty.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/challengeTitle"
            style="@style/Text.Liberty.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/separate_code_title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/challengeBody"
            style="@style/Text.Liberty.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/separate_code_body"
            android:textSize="13sp" />

        <Button
            android:id="@+id/setCodeButton"
            style="@style/Widget.Liberty.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/set_separate_code" />
    </LinearLayout>

    <TextView
        style="@style/Text.Liberty.Eyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/protected_apps" />

    <GridView
        android:id="@+id/appsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:columnWidth="92dp"
        android:gravity="center"
        android:horizontalSpacing="8dp"
        android:numColumns="auto_fit"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="10dp" />

    <TextView
        android:id="@+id/emptyView"
        style="@style/Text.Liberty.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/vault_empty"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal">

        <Button
            android:id="@+id/addAppsButton"
            style="@style/Widget.Liberty.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/add_apps" />

        <Button
            android:id="@+id/lockButton"
            style="@style/Widget.Liberty.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/lock_space" />
    </LinearLayout>

    <Button
        android:id="@+id/changeLanguageButton"
        style="@style/Widget.Liberty.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/vault_language_settings" />

    <Button
        android:id="@+id/removeProfileButton"
        style="@style/Widget.Liberty.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/remove_protected_space" />
</LinearLayout>
