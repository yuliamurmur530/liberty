<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_logo_avatar_medium"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:outlineProvider="background"
                android:src="@drawable/ic_liberty_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Liberty.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_title"
                    android:textSize="22sp" />

                <TextView
                    style="@style/Text.Liberty.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/privacy_updated"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Text.Liberty.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/privacy_intro" />

        <LinearLayout
            style="@style/Widget.Liberty.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Liberty.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_collection_title" />

            <TextView
                style="@style/Text.Liberty.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/privacy_collection_body" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Liberty.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Liberty.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_local_title" />

            <TextView
                style="@style/Text.Liberty.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/privacy_local_body" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Liberty.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Liberty.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_profile_title" />

            <TextView
                style="@style/Text.Liberty.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/privacy_profile_body" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Liberty.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Liberty.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_third_party_title" />

            <TextView
                style="@style/Text.Liberty.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/privacy_third_party_body" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Liberty.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Liberty.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_control_title" />

            <TextView
                style="@style/Text.Liberty.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/privacy_control_body" />
        </LinearLayout>

        <Button
            android:id="@+id/openPolicyWebsiteButton"
            style="@style/Widget.Liberty.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/privacy_open_website" />

        <Button
            android:id="@+id/privacyActionButton"
            style="@style/Widget.Liberty.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/privacy_continue" />
    </LinearLayout>
</ScrollView>
