<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="28dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_logo_avatar"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:outlineProvider="background"
        android:src="@drawable/ic_liberty_mark" />

    <TextView
        style="@style/Text.Liberty.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="@string/language_prompt_ru"
        android:textSize="28sp" />

    <TextView
        style="@style/Text.Liberty.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/language_prompt_en"
        android:textSize="20sp" />

    <TextView
        style="@style/Text.Liberty.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/language_intro_ru" />

    <TextView
        style="@style/Text.Liberty.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/language_intro_en"
        android:textSize="12sp" />

    <Button
        android:id="@+id/russianButton"
        style="@style/Widget.Liberty.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/language_russian" />

    <Button
        android:id="@+id/englishButton"
        style="@style/Widget.Liberty.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/language_english" />
</LinearLayout>
