<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_logo_avatar_small"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:outlineProvider="background"
                android:src="@drawable/ic_liberty_mark" />

            <TextView
                style="@style/Text.Liberty.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/app_name"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            style="@style/Text.Liberty.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/remove_profile_eyebrow" />

        <TextView
            style="@style/Text.Liberty.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/remove_profile_title" />

        <TextView
            style="@style/Text.Liberty.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/remove_profile_body" />

        <LinearLayout
            style="@style/Widget.Liberty.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Liberty.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/remove_profile_data_title" />

            <TextView
                style="@style/Text.Liberty.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/remove_profile_data_body" />
        </LinearLayout>

        <Button
            android:id="@+id/cancelRemoveProfileButton"
            style="@style/Widget.Liberty.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/keep_profile" />

        <Button
            android:id="@+id/confirmRemoveProfileButton"
            style="@style/Widget.Liberty.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/remove_profile_confirm" />
    </LinearLayout>
</ScrollView>
