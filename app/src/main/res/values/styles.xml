<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Liberty" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/liberty_gold</item>
        <item name="android:windowBackground">@color/asphalt_950</item>
        <item name="android:navigationBarColor">@color/asphalt_950</item>
        <item name="android:statusBarColor">@color/asphalt_950</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Text.Liberty.Eyebrow" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/liberty_gold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Liberty.Display" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/white_soft</item>
        <item name="android:textSize">32sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.Liberty.Title" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/white_soft</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Text.Liberty.Body" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/steel_300</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Widget.Liberty.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="Widget.Liberty.Button.Primary" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/asphalt_950</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Liberty.Button.Secondary" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/steel_100</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
